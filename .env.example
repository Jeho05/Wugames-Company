# URL de l'API WUGAMS ERP, servie en same-origin via le proxy next.config.ts
# (contourne le CORS du back-end, aucun changement requis côté serveur).
NEXT_PUBLIC_API_URL=/api/v1

# Optionnel : URL absolue du back-end pour le proxy (défaut : instance Vercel déployée).
# BACKEND_URL=https://wugames-holding-inc.vercel.app
