# URL de l'API WUGAMS ERP, servie en same-origin via le proxy next.config.ts
# (contourne le CORS du back-end, aucun changement requis côté serveur).
NEXT_PUBLIC_API_URL=/api/v1

# Optional : URL absolue du back-end pour le proxy (défaut : instance Vercel déployée).
BACKEND_URL=https://wugames-holding-inc.vercel.app

# Supabase Storage (Option A - Stockage Cloud des images et fichiers)
# Clé publique anon et URL de l'instance Supabase (voir console Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://jnlpwznuihcsisqnyxmj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
